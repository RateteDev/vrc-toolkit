    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@vrc-toolkit/core": "workspace:*",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "wxt": "^0.20.27"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wxt-dev/module-react": "^1.2.2"
  }
}
